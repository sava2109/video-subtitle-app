# Caddy сам прибавља и обнавља Let's Encrypt HTTPS сертификат за {$DOMAIN}
# и преусмерава http -> https. Ништа се не подешава ручно.
#
# Caddy v2 подразумевано НЕМА временско ограничење за тело захтева, па
# уплоад великих видеа (до 500 MB) ради без додатног подешавања.
{$DOMAIN} {
	reverse_proxy app:3001

	encode gzip
}
