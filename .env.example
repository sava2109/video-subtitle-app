# ============================================================
#  Kopiraj u .env i popuni. .env NIKAD ne ide u git!
# ============================================================

# --- Transkripcija ---------------------------------------------------
# Groq Whisper - BESPLATNO! Napravi nalog na https://console.groq.com
# i generisi API kljuc (pocinje sa gsk_). Ako je postavljen, koristi se
# umesto OpenAI-a. Bez ijednog kljuca aplikacija vraca DEMO titlove.
GROQ_API_KEY=

# OpenAI Whisper (placeno) - alternativa Groq-u
OPENAI_API_KEY=

# --- Pristup ---------------------------------------------------------
# Sifra kojom se ulazi na sajt. OBAVEZNO postavi svoju pre nego sto
# aplikaciju izlozis internetu - ako ostane prazno, koristi se
# podrazumevana sifra iz koda koja je vidljiva u javnom repozitorijumu.
SITE_PASSWORD=

# --- Server ----------------------------------------------------------
PORT=3001

# --- Samo za deploy na VPS (docker compose) --------------------------
# Domen na kojem sajt radi. Caddy za njega automatski uzima HTTPS
# sertifikat. Ako nemas domen, koristi <IP-SERVERA>.nip.io
# (npr. 203.0.113.45.nip.io) - radi odmah i besplatno.
DOMAIN=
